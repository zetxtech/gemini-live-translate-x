<Window x:Class="MeetingTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Translator"
        Width="740" Height="860"
        MinWidth="620" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Title Bar ════════════════════════════════════════ -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#6d4dfc" Offset="0"/>
                    <GradientStop Color="#9b6dff" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="🎙" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Meeting Translator" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Gemini Live Translate" FontSize="11"
                               Foreground="#c4b5fd" VerticalAlignment="Center" Margin="16,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="─" Style="{StaticResource TitleBarButton}"
                            Click="Minimize_Click" Margin="0,0,4,0"/>
                    <Button Content="✕" Style="{StaticResource TitleBarButton}"
                            Click="Close_Click">
                        <Button.Resources>
                            <Style TargetType="Border" x:Key="CloseHover">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Scrollable Content ═══════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,12,24,20">
            <StackPanel HorizontalAlignment="Stretch">

                <!-- ── API Key Card ─────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="🔑  Gemini API Key"/>
                        <TextBox x:Name="ApiEntry" Style="{StaticResource ModernTextBox}"
                                 FontFamily="Consolas" Margin="0,0,0,8"
                                 GotFocus="ApiEntry_GotFocus" LostFocus="ApiEntry_LostFocus"/>
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Get key: aistudio.google.com/apikey"
                                       VerticalAlignment="Center"/>
                            <Button Content="Show / Hide" Style="{StaticResource SmallButton}"
                                    DockPanel.Dock="Right" Click="ToggleKeyVisibility_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ── Model Card ───────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="🤖  Model"/>
                        <TextBox x:Name="ModelEntry" Style="{StaticResource ModernTextBox}"
                                 FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                   Text="Type a model name or pick a preset below"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="gemini-3.5-live-translate-preview"
                                    Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                    Click="ModelPreset_Click"/>
                            <Button Content="gemini-2.0-flash-exp"
                                    Style="{StaticResource SmallButton}"
                                    Click="ModelPreset_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Audio Source Card ────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="🔊  Audio Source"
                                       DockPanel.Dock="Left"/>
                            <Button Content="⟳ Refresh" Style="{StaticResource SmallButton}"
                                    DockPanel.Dock="Right" Click="RefreshDevices_Click"/>
                        </DockPanel>
                        <ComboBox x:Name="DeviceCombo" Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="Name" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- ── Options Card ─────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="⚙️  Options"/>
                        <CheckBox x:Name="BilingualCheck" Style="{StaticResource DarkCheckBox}"
                                  Content="Show bilingual subtitles (original + translation)"
                                  IsChecked="True" Margin="0,2"/>
                        <CheckBox x:Name="VoiceCheck" Style="{StaticResource DarkCheckBox}"
                                  Content="Enable translated audio playback 🔊"
                                  IsChecked="True" Margin="0,4"/>
                    </StackPanel>
                </Border>

                <!-- ── Control Buttons ──────────────────────────── -->
                <Button x:Name="StartBtn" Content="▶  Start Translation"
                        Style="{StaticResource AccentButton}" Margin="0,4,0,6"
                        HorizontalAlignment="Stretch" Click="Start_Click"/>
                <Button x:Name="StopBtn" Content="■  Stop"
                        Style="{StaticResource StopButton}" Margin="0,4,0,6"
                        HorizontalAlignment="Stretch" Click="Stop_Click"
                        Visibility="Collapsed"/>

                <!-- ── Status ───────────────────────────────────── -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <TextBlock Text="Status:" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Text2Brush}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="12"
                               Foreground="{StaticResource Text3Brush}"/>
                </StackPanel>

                <!-- ── Subtitle Area ────────────────────────────── -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="14"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,8" MinHeight="200">
                    <Grid Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Live Subtitles" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="10,8,10,10"/>

                        <RichTextBox x:Name="SubtitleBox" Grid.Row="1"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0" IsReadOnly="True"
                                     FontFamily="Segoe UI" FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Margin="10,0,6,10"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
